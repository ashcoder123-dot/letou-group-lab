{
  "name": "letou-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser-check.mjs",
    "check:static": "node scripts/check-static.mjs",
    "data:sync": "node scripts/update-data.mjs",
    "deploy": "npm run build && npm run check:static && wrangler pages deploy dist --project-name letou-group-lab --branch main"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.4",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
